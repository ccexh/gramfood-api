{
    "files.exclude": {
        ".venv": true,
        ".ruff_cache": true,
        "*.egg-info": true,
        "**/__pycache__": true
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportImportCycles": "none"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    }
}